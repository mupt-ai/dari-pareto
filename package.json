{
  "name": "@mupt-ai/dari-pareto",
  "version": "0.2.0",
  "description": "Static and interactive Pareto frontier plots for evaluation results.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mupt-ai/dari-pareto.git"
  },
  "homepage": "https://github.com/mupt-ai/dari-pareto#readme",
  "bugs": {
    "url": "https://github.com/mupt-ai/dari-pareto/issues"
  },
  "keywords": [
    "pareto-frontier",
    "data-visualization",
    "benchmark",
    "evaluation",
    "react",
    "svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "default": "./dist/static.js"
    }
  },
  "files": [
    "dist",
    "docs/pareto-example.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "example:static": "bun run examples/generate-static.ts",
    "test:package": "bash scripts/test-package.sh",
    "prepublishOnly": "bun run typecheck && bun test && bun run test:package"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.6.3"
  }
}
